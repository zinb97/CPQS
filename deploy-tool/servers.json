{
  "deploy_path": "/opt/CPQS",
  "key_path": "~/.ssh/id_rsa",
  "source": "..",
  "connect_timeout": 10,
  "jobs": 5,
  "timeout": 900,
  "strict_host_key_checking": "accept-new",
  "exclude": [],
  "group": {
    "dep": ["X1", "X2", "X3", "X4", "X5", "L1", "L2", "L3", "L4"],
    "exe": ["X1", "X2", "X3", "X4", "X5", "L1", "L2", "L3", "L4", "S1"],
    "xfusion": ["X1", "X2", "X3", "X4", "X5"],
    "hello": ["L1", "L2", "L3", "L4"],
    "kd": ["S1", "S2"]
  },
  "tasks": {
    "collector": {
      "command": "/usr/bin/python3 metrics_exporter.py --port 9100",
      "cwd": "collector",
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "stop_timeout": 10
    }
  },
  "servers": [
    {
      "name": "X1",
      "host": "S501.site",
      "port": 1011,
      "user": "xfusion"
    },
    {
      "name": "X2",
      "host": "S501.site",
      "port": 1012,
      "user": "xfusion"
    },
    {
      "name": "X3",
      "host": "S501.site",
      "port": 1013,
      "user": "xfusion"
    },
    {
      "name": "X4",
      "host": "S501.site",
      "port": 1014,
      "user": "xfusion"
    },
    {
      "name": "X5",
      "host": "S501.site",
      "port": 1015,
      "user": "xfusion"
    },
    {
      "name": "L1",
      "host": "S501.site",
      "port": 1021,
      "user": "hello"
    },
    {
      "name": "L2",
      "host": "S501.site",
      "port": 1022,
      "user": "hello"
    },
    {
      "name": "L3",
      "host": "S501.site",
      "port": 1023,
      "user": "hello"
    },
    {
      "name": "L4",
